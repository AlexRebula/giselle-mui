# Temporary — remove once eslint-plugin-react publishes a release whose
# peerDependencies declare ESLint 10 support (currently latest is 7.37.5,
# capped at "^9.7"). Verified this codebase's actual usage of the plugin's
# rules runs correctly under ESLint 10 (lint/typecheck/tests/build all
# green) — the conflict is a stale peer-range declaration upstream, not a
# real incompatibility. No `dependencies` are shipped to consumers from this
# package (devDependencies only), so this is scoped to local/CI tooling.
legacy-peer-deps=true
